# X Layer Testnet deployment. Never commit a funded key.
XLAYER_PRIVATE_KEY=0x...

# Filled after `pnpm contracts:deploy:xlayer`.
VITE_EXIT_TOGETHER_ADDRESS=0x...
VITE_DEMO_RWA_TOKEN=0x...
VITE_DEMO_USD_TOKEN=0x...
VITE_EXIT_TOGETHER_BATCH_ID=1

# Optional OKX OnchainOS DEX adapter. This is only valid for supported onchain
# token pairs; it cannot execute the centralized SPCXUSD X-Perp.
